{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CMake: Debug",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "cwd": "${workspaceFolder}/cwd",
      "environment": [
        {
          "name": "PATH",
          "value": "${env:PATH};${command:cmake.getLaunchTargetDirectory}"
        }
      ],
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "args": []
    }
  ]
}